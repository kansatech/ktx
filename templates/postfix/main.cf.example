# KTX internal relay baseline. Validate with the Postfix version in the image.

myhostname = ktx-mail-01
myorigin = $myhostname
mydestination =
inet_interfaces = all
inet_protocols = all

# The container is not published publicly. Site containers reach it only on
# their private Docker network attachments. Docker bridge ranges are trusted
# for relay; do not publish TCP 25 to an untrusted host interface.
mynetworks = 127.0.0.0/8 172.16.0.0/12
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination

# Default upstream; sender_dependent_relayhost_maps can override this.
relayhost = [smtp.example-provider.com]:587
sender_dependent_relayhost_maps = hash:/etc/postfix/sender_relay

smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sender_dependent_authentication = yes
smtp_tls_security_level = encrypt
smtp_tls_CApath = /etc/ssl/certs

# Keep queue behavior finite and logs useful.
maximal_queue_lifetime = 2d
bounce_queue_lifetime = 1d
