entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    address: ":443"

providers:
  docker:
    endpoint: "tcp://ktx-dockerapi-01:2375"
    exposedByDefault: false
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: REPLACE_ACME_EMAIL
      storage: /var/lib/traefik/acme/acme.json
      httpChallenge:
        entryPoint: web

api:
  dashboard: true
  insecure: false
ping: {}
log:
  level: INFO
accessLog: {}
