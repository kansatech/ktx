services:
  proxy:
    image: ktx/proxy:REPLACE_RELEASE
    container_name: ktx-proxy-01
    hostname: ktx-proxy-01
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /srv/ktx/containers/ktx-proxy-01/traefik.yml:/etc/traefik/traefik.yml:ro
      - /srv/ktx/data/proxy-01/acme:/var/lib/traefik/acme
    networks:
      - control

networks:
  control:
    external: true
    name: ktx-control
