services:
  web:
    image: ktx/web-php85:REPLACE_RELEASE
    container_name: ktx-web-REPLACE_SLUG-01
    hostname: ktx-web-REPLACE_SLUG-01
    restart: unless-stopped
    mem_limit: 384m
    mem_reservation: 64m
    pids_limit: 256
    volumes:
      - /srv/ktx/sites/REPLACE_SLUG/app:/var/www/html
      - /srv/ktx/sites/REPLACE_SLUG/cron/ktx-site:/etc/cron.d/ktx-site:ro
      - /srv/ktx/sites/REPLACE_SLUG/ssh/hostkeys:/etc/ssh/ktx-hostkeys
      - /srv/ktx/secrets/sites/REPLACE_SLUG:/run/ktx-secrets:ro
    networks: [site]
    labels:
      traefik.enable: "true"
      traefik.http.routers.REPLACE_SLUG.rule: "Host(`REPLACE_DOMAIN`)"
      traefik.http.routers.REPLACE_SLUG.entrypoints: "websecure"
      traefik.http.routers.REPLACE_SLUG.tls: "true"
      traefik.http.routers.REPLACE_SLUG.tls.certresolver: "letsencrypt"
      traefik.http.services.REPLACE_SLUG.loadbalancer.server.port: "8080"
      traefik.docker.network: "ktx-site-REPLACE_SLUG"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:8080/__ktx/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

networks:
  site:
    external: true
    name: ktx-site-REPLACE_SLUG
