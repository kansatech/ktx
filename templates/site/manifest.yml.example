slug: example
container: ktx-web-example-01
image: ktx/web-php85:2026.09.10-r1
network: ktx-site-example

domains:
  - example.com
  - www.example.com

database:
  enabled: true
  name: example_app
  user: example_app

ssh:
  enabled: true
  external_login: example

mail:
  enabled: true

logging:
  enabled: true

resources:
  memory_limit: 384m
  pids_limit: 256

notes: []
