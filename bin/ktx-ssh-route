#!/usr/bin/env python3
import argparse
import ipaddress
import os
import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path('/srv/ktx/config/sshpiper/routes')
LOGIN_RE = re.compile(r'^[a-zA-Z0-9._-]{1,64}$')
USER_RE = re.compile(r'^[a-zA-Z0-9._-]{1,64}$')


def route_dir(login):
    return ROOT / login


def read_input(name):
    if name == '-':
        return sys.stdin.read()
    return pathlib.Path(name).read_text()


def secure_tree(path):
    for item in path.iterdir():
        if item.is_file():
            os.chmod(item, 0o600)
    os.chmod(path, 0o700)
    shutil.chown(path, user='sshpiper', group='sshpiper')
    for item in path.iterdir():
        shutil.chown(item, user='sshpiper', group='sshpiper')


def main():
    if os.geteuid() != 0:
        sys.exit('ktx-ssh-route must run as root')
    if shutil.which('ssh-keygen') is None:
        sys.exit('ssh-keygen is required')
    try:
        import pwd
        pwd.getpwnam('sshpiper')
    except Exception:
        sys.exit('sshpiper service account does not exist; install/configure Host Core SSH first')

    ap = argparse.ArgumentParser()
    sp = ap.add_subparsers(dest='cmd', required=True)
    initp = sp.add_parser('init')
    initp.add_argument('login')
    initp.add_argument('upstream_user')
    initp.add_argument('ip')
    initp.add_argument('port', type=int)
    authp = sp.add_parser('authorize')
    authp.add_argument('login')
    authp.add_argument('keyfile', help="public key file, or '-' for stdin")
    revp = sp.add_parser('revoke')
    revp.add_argument('login')
    revp.add_argument('keyfile', help="public key file, or '-' for stdin")
    trustp = sp.add_parser('trust')
    trustp.add_argument('login')
    trustp.add_argument('knownhostsfile', help="known_hosts-format file, or '-' for stdin")
    showp = sp.add_parser('show')
    showp.add_argument('login')
    removep = sp.add_parser('remove')
    removep.add_argument('login')
    sp.add_parser('list')
    args = ap.parse_args()

    ROOT.mkdir(parents=True, exist_ok=True)

    if args.cmd == 'list':
        for path in sorted(ROOT.iterdir() if ROOT.exists() else []):
            if path.is_dir():
                print(path.name)
        return

    if not LOGIN_RE.match(args.login):
        sys.exit('invalid login')
    path = route_dir(args.login)

    if args.cmd == 'show':
        if not path.exists():
            sys.exit('not found')
        print((path / 'sshpiper_upstream').read_text().strip() if (path / 'sshpiper_upstream').exists() else '(no upstream)')
        print('authorized_keys:', sum(1 for q in (path / 'authorized_keys').read_text().splitlines() if q.strip()) if (path / 'authorized_keys').exists() else 0)
        print('known_hosts:', sum(1 for q in (path / 'known_hosts').read_text().splitlines() if q.strip()) if (path / 'known_hosts').exists() else 0)
        print('mapping_pub:', (path / 'id_rsa.pub').read_text().strip() if (path / 'id_rsa.pub').exists() else '(missing)')
        return

    if args.cmd == 'remove':
        if args.login == 'ktx':
            sys.exit("the reserved 'ktx' host-administration route cannot be removed with ktx-ssh-route")
        if path.exists():
            shutil.rmtree(path)
        print(f'removed {args.login}')
        return

    if args.cmd == 'init':
        if not USER_RE.match(args.upstream_user):
            sys.exit('invalid upstream user')
        ipaddress.ip_address(args.ip)
        if not (1 <= args.port <= 65535):
            sys.exit('invalid port')
        if args.login == 'root' or args.upstream_user == 'root':
            sys.exit("root SSH routes are not permitted")
        if args.login == 'ktx' and not (
            args.upstream_user == 'ktx' and args.ip == '127.0.0.1' and args.port == 2222
        ):
            sys.exit("login 'ktx' is reserved for ktx@127.0.0.1:2222")
        if path.exists() and any(path.iterdir()):
            sys.exit('route exists')
        path.mkdir(parents=True, exist_ok=True)
        (path / 'sshpiper_upstream').write_text(f'{args.upstream_user}@{args.ip}:{args.port}\n')
        (path / 'authorized_keys').touch()
        (path / 'known_hosts').touch()
        # The workingdir plugin expects the mapping-key filename id_rsa.
        subprocess.run(['ssh-keygen', '-q', '-t', 'rsa', '-b', '4096', '-N', '', '-f', str(path / 'id_rsa')], check=True)
        secure_tree(path)
        print('mapping public key (install in the upstream account authorized_keys):')
        print((path / 'id_rsa.pub').read_text().strip())
        return

    if not path.exists():
        sys.exit('route not found; run init first')

    if args.cmd in ('authorize', 'revoke'):
        key = read_input(args.keyfile).strip()
        if not key:
            sys.exit('public-key input is empty')
        target = path / 'authorized_keys'
        lines = [q for q in target.read_text().splitlines() if q.strip()]
        if args.cmd == 'authorize' and key not in lines:
            lines.append(key)
        if args.cmd == 'revoke':
            lines = [q for q in lines if q != key]
        target.write_text('\n'.join(lines) + ('\n' if lines else ''))
    elif args.cmd == 'trust':
        lines = [q.strip() for q in read_input(args.knownhostsfile).splitlines() if q.strip()]
        if not lines:
            sys.exit('known_hosts input empty')
        (path / 'known_hosts').write_text('\n'.join(lines) + '\n')

    secure_tree(path)
    print('updated; SSHPiper restart is not required for route-file changes')


if __name__ == '__main__':
    main()
