#!/usr/bin/env bash
set -u
fail=0
ok(){ printf 'OK   %s\n' "$*"; }
warn(){ printf 'WARN %s\n' "$*"; }
bad(){ printf 'FAIL %s\n' "$*"; fail=1; }

for s in ssh sshpiper docker traefik rsyslog; do
  systemctl is-active --quiet "$s" && ok "service $s active" || bad "service $s not active"
done

if systemctl is-active --quiet ssh.socket; then
  bad 'ssh.socket is active; KTX final state uses direct loopback-only ssh.service'
else
  ok 'ssh.socket inactive'
fi

if ss -lntp | grep -E '[:.]22[[:space:]].*sshpiperd' >/dev/null; then
  ok 'SSHPiper owns public SSH :22'
else
  bad 'SSHPiper not detected on public SSH :22'
fi

ss -lntH | awk '{print $4}' | grep -qx '127.0.0.1:2222' \
  && ok 'host OpenSSH loopback 127.0.0.1:2222' \
  || bad 'host OpenSSH not listening on 127.0.0.1:2222'

if ss -lntH | awk '{print $4}' | grep -Eq '^(0\.0\.0\.0|\[::\]|\*):2222$'; then
  bad 'host OpenSSH :2222 is publicly bound'
else
  ok 'host OpenSSH :2222 is not publicly bound'
fi

for p in 80 443 514; do
  ss -lntH | awk '{print $4}' | grep -Eq "[:.]${p}$" && ok "tcp $p listening" || warn "tcp $p not listening"
done

docker info >/dev/null 2>&1 && ok 'Docker daemon responsive' || bad 'Docker daemon unavailable'
[[ -r /srv/ktx/config/host.conf ]] && ok 'host.conf readable' || bad 'host.conf missing'
[[ -f /srv/ktx/config/sshpiper/routes/ktx/sshpiper_upstream ]] && ok 'SSHPiper ktx host route present' || bad 'SSHPiper ktx host route missing'
[[ -s /home/ktx/.ssh/authorized_keys ]] && ok 'ktx upstream authorized_keys present' || bad 'ktx upstream authorized_keys empty/missing'

exit "$fail"
