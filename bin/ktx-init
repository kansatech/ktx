#!/usr/bin/env bash
set -euo pipefail
ROOT="${KTX_ROOT:-/srv/ktx}"

usage() {
  cat <<'EOF'
Usage:
  sudo ./bin/ktx-init bootstrap --hostname HOST --env build|dev|prod
  sudo ./bin/ktx-init secure-ssh
  sudo ./bin/ktx-init finish --acme-email EMAIL
  sudo ./bin/ktx-init status

Fresh-host order:
  1. Create the ktx account manually (see INSTALL.md).
  2. bootstrap
  3. Install and verify your workstation public key.
  4. secure-ssh
  5. finish
EOF
}

require_root() {
  [[ "$(id -u)" -eq 0 ]] || { echo "Run with sudo/root." >&2; exit 1; }
}

conf_set() {
  local key="$1" value="$2" file="${ROOT}/config/host.conf"
  if grep -qE "^${key}=" "$file"; then
    sed -i "s#^${key}=.*#${key}=${value}#" "$file"
  else
    printf '%s=%s\n' "$key" "$value" >> "$file"
  fi
}

install_base_packages() {
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    curl gnupg jq rsync zstd unzip tar openssh-server chrony rsyslog \
    logrotate ufw acl python3 sudo mc netcat-openbsd
}

validate_ktx_user() {
  if ! id ktx >/dev/null 2>&1; then
    cat >&2 <<'EOF'
ERROR: required administrator account 'ktx' does not exist.
KTX intentionally does not create administrator identities.
Create it first as shown in INSTALL.md, then rerun bootstrap.
EOF
    exit 1
  fi

  if ! id -nG ktx | tr ' ' '\n' | grep -qx sudo; then
    echo "ERROR: user 'ktx' must be a member of the sudo group." >&2
    exit 1
  fi

  local home
  home="$(getent passwd ktx | cut -d: -f6)"
  [[ "$home" == "/home/ktx" ]] || {
    echo "ERROR: KTX Host Core currently expects the ktx home directory to be /home/ktx (found: ${home})." >&2
    exit 1
  }

  if ! passwd -S ktx | awk '{exit ($2=="P" ? 0 : 1)}'; then
    cat >&2 <<'EOF'
ERROR: user 'ktx' does not have a local password yet.
The fresh-host procedure temporarily uses that password for the first SSH login and for sudo.
Set it with: passwd ktx
Then rerun bootstrap.
EOF
    exit 1
  fi

  install -d -o ktx -g ktx -m 0700 /home/ktx/.ssh
  touch /home/ktx/.ssh/authorized_keys
  chown ktx:ktx /home/ktx/.ssh/authorized_keys
  chmod 0600 /home/ktx/.ssh/authorized_keys

  # Module repositories are managed by the human ktx administrator.
  install -d -o ktx -g ktx -m 0755 "${ROOT}/images"
}

write_bootstrap_sshd() {
  cat >/etc/ssh/sshd_config.d/10-ktx.conf <<'EOF'
Port 22
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
X11Forwarding no
AllowUsers ktx

# Password SSH exists only during initial bootstrap, and only for ktx.
Match User ktx
    PasswordAuthentication yes
Match all
EOF

  sshd -t
  systemctl enable --now ssh.service
  systemctl reload ssh.service
}

install_docker() {
  apt-get remove -y docker.io docker-compose docker-compose-v2 docker-doc docker-buildx \
    podman-docker containerd runc 2>/dev/null || true
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  cat >/etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
EOF
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  install -d -m 0755 /etc/docker
  install -o root -g root -m 0644 "${ROOT}/host/docker/daemon.json" /etc/docker/daemon.json
  dockerd --validate --config-file=/etc/docker/daemon.json
  systemctl enable --now docker
  systemctl restart docker
}

bootstrap() {
  require_root
  local hostname="" env=""
  shift
  while (($#)); do
    case "$1" in
      --hostname) hostname="$2"; shift 2 ;;
      --env) env="$2"; shift 2 ;;
      *) echo "Unknown option: $1" >&2; usage; exit 2 ;;
    esac
  done

  [[ -n "$hostname" ]] || { echo "--hostname is required" >&2; exit 2; }
  [[ "$env" =~ ^(build|dev|prod)$ ]] || { echo "--env must be build, dev, or prod" >&2; exit 2; }

  . /etc/os-release
  [[ "${ID:-}" == ubuntu && "${VERSION_ID:-}" == 24.04 ]] || {
    echo "KTX Host Core currently targets Ubuntu 24.04 LTS." >&2
    exit 1
  }

  validate_ktx_user
  "${ROOT}/bin/ktx-init-layout"
  install_base_packages
  hostnamectl set-hostname "$hostname"
  timedatectl set-timezone UTC
  conf_set KTX_ENV "$env"
  conf_set KTX_HOST "$hostname"
  write_bootstrap_sshd
  systemctl enable --now chrony rsyslog

  echo
  echo "BOOTSTRAP COMPLETE"
  echo "KTX did not create or change the identity of the ktx administrator account."
  echo "Public SSH :22 currently goes directly to OpenSSH."
  echo "Password SSH is temporarily allowed ONLY for ktx. Root SSH is disabled."
  echo "Midnight Commander (mc) and the remaining Host Core prerequisites are installed."
  echo
  echo "Next, from your workstation:"
  echo "  ssh ktx@${hostname}"
  echo "  # install your public key, then prove key authentication in a NEW session"
  echo
  echo "Do NOT run secure-ssh until public-key login works."
}

secure_ssh() {
  require_root
  validate_ktx_user

  local auth=/home/ktx/.ssh/authorized_keys
  local route="${ROOT}/config/sshpiper/routes/ktx"
  local sshpiper_secrets="${ROOT}/secrets/sshpiper"

  [[ -s "$auth" ]] || {
    echo "${auth} is empty. Install and verify your workstation public key first." >&2
    exit 1
  }

  #
  # Install SSHPiper first, but do not start it yet.
  #
  "${ROOT}/bin/ktx-install-native" sshpiper

  #
  # Dedicated unprivileged SSHPiper service account.
  #
  if ! id sshpiper >/dev/null 2>&1; then
    useradd \
      --system \
      --home /nonexistent \
      --shell /usr/sbin/nologin \
      sshpiper
  fi

  #
  # /srv/ktx/secrets itself should remain private to root.
  #
  # SSHPiper only needs permission to traverse the parent directory so it can
  # reach its own private subtree. Do NOT chmod /srv/ktx/secrets to 0755.
  #
  # Result:
  #
  #   /srv/ktx/secrets             root:root       0700 + ACL sshpiper:--x
  #   /srv/ktx/secrets/sshpiper    sshpiper:sshpiper 0700
  #
  setfacl -m u:sshpiper:--x "${ROOT}/secrets"

  install -d \
    -o sshpiper \
    -g sshpiper \
    -m 0700 \
    "${ROOT}/config/sshpiper/routes"

  install -d \
    -o sshpiper \
    -g sshpiper \
    -m 0700 \
    "$sshpiper_secrets"

  #
  # Create the special host-administration route if it does not already exist.
  #
  if [[ ! -d "$route" ]]; then
    "${ROOT}/bin/ktx-ssh-route" init \
      ktx \
      ktx \
      127.0.0.1 \
      2222 \
      >/tmp/ktx-ssh-route-init.out

    #
    # Downstream authentication:
    # Workstation -> SSHPiper.
    #
    # Use the same workstation public key(s) already proven against native SSH.
    #
    install \
      -o sshpiper \
      -g sshpiper \
      -m 0600 \
      "$auth" \
      "$route/authorized_keys"

    #
    # Upstream authentication:
    # SSHPiper -> native OpenSSH on 127.0.0.1:2222.
    #
    # ktx-ssh-route generated a mapping key pair. Add its public half to the
    # real ktx account so SSHPiper can authenticate upstream.
    #
    cat "$route/id_rsa.pub" >> "$auth"
    sort -u "$auth" -o "$auth"

    chown ktx:ktx "$auth"
    chmod 0600 "$auth"
  fi

  #
  # Preserve the existing public SSH host identity.
  #
  # SSHPiper replaces sshd on public TCP 22, so reuse the current OpenSSH
  # Ed25519 host key rather than presenting clients with an unexpected new key.
  #
  install \
    -o sshpiper \
    -g sshpiper \
    -m 0600 \
    /etc/ssh/ssh_host_ed25519_key \
    "$sshpiper_secrets/server_key"

  #
  # Sanity-check ownership/permissions before attempting the cutover.
  #
  chown sshpiper:sshpiper "$sshpiper_secrets/server_key"
  chmod 0600 "$sshpiper_secrets/server_key"

  #
  # Make sure the SSHPiper process can actually traverse the secret path and
  # read its host key. This catches the exact failure we just ran into.
  #
  if ! runuser -u sshpiper -- test -r "$sshpiper_secrets/server_key"; then
    echo "SSHPiper cannot read $sshpiper_secrets/server_key." >&2
    echo "Check permissions/ACLs on ${ROOT}/secrets and $sshpiper_secrets." >&2
    getfacl "${ROOT}/secrets" >&2 || true
    ls -ld "${ROOT}/secrets" "$sshpiper_secrets" >&2 || true
    ls -l "$sshpiper_secrets/server_key" >&2 || true
    exit 1
  fi

  #
  # Install the unit before changing the public SSH listener, but do not start
  # SSHPiper yet.
  #
  ln -sfn \
    "${ROOT}/host/systemd/sshpiper.service" \
    /etc/systemd/system/sshpiper.service

  systemctl daemon-reload
  systemctl enable sshpiper.service

  #
  # Verify the unit really runs SSHPiper as the dedicated account.
  #
  local unit_user
  local unit_group

  unit_user="$(systemctl show sshpiper.service -p User --value)"
  unit_group="$(systemctl show sshpiper.service -p Group --value)"

  if [[ "$unit_user" != "sshpiper" || "$unit_group" != "sshpiper" ]]; then
    echo "sshpiper.service must run as sshpiper:sshpiper." >&2
    echo "Current unit: User=${unit_user:-<unset>} Group=${unit_group:-<unset>}" >&2
    exit 1
  fi

  #
  # Final native OpenSSH policy.
  #
  # Native sshd is now an INTERNAL upstream service only.
  # It must never listen on a LAN/public interface after this point.
  #
  cat >/etc/ssh/sshd_config.d/10-ktx.conf <<'EOF'
Port 2222
ListenAddress 127.0.0.1

PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no

X11Forwarding no
AllowAgentForwarding no

AllowUsers ktx
EOF

  sshd -t

  #
  # Ubuntu 24.04 commonly uses systemd socket activation for OpenSSH.
  #
  # KTX deliberately disables ssh.socket after bootstrap so ssh.service itself
  # owns exactly one listener: 127.0.0.1:2222.
  #
  # KEEP THE CURRENT SESSION / VM CONSOLE OPEN THROUGH THIS CUTOVER.
  #
  if systemctl list-unit-files ssh.socket >/dev/null 2>&1; then
    systemctl disable --now ssh.socket 2>/dev/null || true
  fi

  systemctl enable ssh.service
  systemctl restart ssh.service

  sleep 1

  #
  # Native sshd MUST now exist only on loopback:2222.
  #
  if ! ss -lntH | awk '{print $4}' | grep -qx '127.0.0.1:2222'; then
    echo "Host OpenSSH did not bind to 127.0.0.1:2222." >&2
    systemctl status ssh.service --no-pager >&2 || true
    ss -lntp | grep -E ':(22|2222)\b' >&2 || true
    exit 1
  fi

  if ss -lntH | awk '{print $4}' \
      | grep -Eq '^(0\.0\.0\.0|\[::\]|\*):2222$'; then
    echo "Host OpenSSH is unexpectedly exposed on a non-loopback :2222 listener." >&2
    exit 1
  fi

  if systemctl is-active --quiet ssh.socket; then
    echo "ssh.socket is still active; refusing to continue the SSHPiper cutover." >&2
    exit 1
  fi

  #
  # Pin the upstream SSH identity SSHPiper expects for the loopback hop.
  #
  ssh-keyscan \
    -p 2222 \
    127.0.0.1 \
    2>/dev/null \
    > "$route/known_hosts"

  chown sshpiper:sshpiper "$route/known_hosts"
  chmod 0600 "$route/known_hosts"

  #
  # Final permission sanity check before giving SSHPiper public TCP 22.
  #
  if ! runuser -u sshpiper -- test -r "$route/known_hosts"; then
    echo "SSHPiper cannot read $route/known_hosts." >&2
    exit 1
  fi

  if ! runuser -u sshpiper -- test -r "$route/authorized_keys"; then
    echo "SSHPiper cannot read $route/authorized_keys." >&2
    exit 1
  fi

  if ! runuser -u sshpiper -- test -r "$route/id_rsa"; then
    echo "SSHPiper cannot read $route/id_rsa." >&2
    exit 1
  fi

  #
  # Only now allow SSHPiper to take public TCP 22.
  #
  systemctl restart sshpiper.service

  sleep 1

  if ! systemctl is-active --quiet sshpiper.service; then
    journalctl -u sshpiper -n 100 --no-pager >&2 || true
    exit 1
  fi

  if ! ss -lntp \
      | grep -E '[:.]22[[:space:]].*sshpiperd' \
      >/dev/null; then
    echo "SSHPiper is active but was not detected as the TCP 22 listener." >&2
    ss -lntp | grep -E ':(22|2222)\b' >&2 || true
    exit 1
  fi

  echo
  echo "SSH CUTOVER COMPLETE"
  echo
  echo "Public TCP 22:"
  echo "  SSHPiper"
  echo
  echo "Host administration route:"
  echo "  ktx -> ktx@127.0.0.1:2222"
  echo
  echo "Native OpenSSH:"
  echo "  127.0.0.1:2222 only"
  echo "  public-key authentication only"
  echo "  root login disabled"
  echo "  ssh.socket disabled"
  echo
  echo "KEEP THIS SESSION / CONSOLE OPEN."
  echo
  echo "From a SECOND terminal verify:"
  echo
  echo "  ssh ktx@$(hostname -f 2>/dev/null || hostname)"
  echo
  echo "Only continue to 'finish' after the new SSHPiper path works."
}

finish() {
  require_root
  local email=""
  shift
  while (($#)); do
    case "$1" in
      --acme-email) email="$2"; shift 2 ;;
      *) echo "Unknown option: $1" >&2; usage; exit 2 ;;
    esac
  done
  [[ -n "$email" && "$email" == *@* ]] || { echo "--acme-email is required" >&2; exit 2; }
  systemctl is-active --quiet sshpiper || { echo "SSHPiper is not active. Run secure-ssh first." >&2; exit 1; }
  systemctl is-active --quiet ssh.socket && { echo "ssh.socket must be inactive after secure-ssh." >&2; exit 1; }

  install_docker
  "${ROOT}/bin/ktx-install-native" traefik
  "${ROOT}/bin/ktx-init-layout"
  conf_set KTX_ACME_EMAIL "$email"

  if ! id traefik >/dev/null 2>&1; then
    useradd --system --home /nonexistent --shell /usr/sbin/nologin traefik
  fi
  install -d -o root -g traefik -m 0750 \
    "${ROOT}/config/traefik" "${ROOT}/config/traefik/dynamic"
  install -d -o traefik -g traefik -m 0750 \
    "${ROOT}/data/traefik" "${ROOT}/logs/traefik"
  sed "s/__KTX_ACME_EMAIL__/${email//\//\\/}/g" \
    "${ROOT}/host/defaults/traefik.yml.example" > "${ROOT}/config/traefik/traefik.yml"
  chown root:traefik "${ROOT}/config/traefik/traefik.yml"
  chmod 0640 "${ROOT}/config/traefik/traefik.yml"
  touch "${ROOT}/data/traefik/acme.json"
  chown traefik:traefik "${ROOT}/data/traefik/acme.json"
  chmod 0600 "${ROOT}/data/traefik/acme.json"

  install -d -o syslog -g adm -m 0750 "${ROOT}/logs/remote"
  "${ROOT}/bin/ktx-apply-host"
  rsyslogd -N1
  systemctl restart rsyslog
  systemctl enable --now traefik

  local pool
  pool="$(awk -F= '$1=="KTX_DOCKER_POOL"{print $2}' "${ROOT}/config/host.conf")"
  ufw default deny incoming
  ufw default allow outgoing
  ufw allow 22/tcp
  ufw allow 80/tcp
  ufw allow 443/tcp
  ufw allow from "$pool" to any port 514 proto tcp
  ufw --force enable

  echo
  echo "KTX HOST CORE COMPLETE"
  "${ROOT}/bin/ktx-host-check" || true
  echo
  echo "Review INSTALL.md acceptance checks, then commit/tag Host Core changes from build as normal."
}

status() {
  require_root
  "${ROOT}/bin/ktx-host-check"
}

case "${1:-}" in
  bootstrap) bootstrap "$@" ;;
  secure-ssh) secure_ssh ;;
  finish) finish "$@" ;;
  status) status ;;
  *) usage; exit 2 ;;
esac
