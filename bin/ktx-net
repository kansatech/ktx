#!/usr/bin/env python3
import argparse, ipaddress, pathlib, subprocess, sys, os

CONF=pathlib.Path('/srv/ktx/config/host.conf')
REG=pathlib.Path('/srv/ktx/config/networks.tsv')

def conf():
    d={}
    if CONF.exists():
        for line in CONF.read_text().splitlines():
            line=line.strip()
            if not line or line.startswith('#') or '=' not in line: continue
            k,v=line.split('=',1); d[k.strip()]=v.strip()
    return d

def load():
    rows=[]
    if REG.exists():
        for line in REG.read_text().splitlines():
            if not line.strip() or line.startswith('#'): continue
            p=line.split('\t')
            if len(p)>=6:
                rows.append(dict(name=p[0], subnet=p[1], gateway=p[2], primary=p[3], bridge=p[4], idx=int(p[5])))
    return rows

def save(rows):
    REG.parent.mkdir(parents=True, exist_ok=True)
    tmp=REG.with_suffix('.tmp')
    with tmp.open('w') as f:
        for r in sorted(rows,key=lambda x:x['idx']):
            f.write(f"{r['name']}\t{r['subnet']}\t{r['gateway']}\t{r['primary']}\t{r['bridge']}\t{r['idx']}\n")
    os.replace(tmp,REG)

def run(*args, check=True):
    return subprocess.run(args, check=check, text=True, capture_output=True)

def get_row(rows, token):
    names={token, f"ktx-net-{token}"}
    for r in rows:
        if r['name'] in names: return r
    return None

def main():
    if os.geteuid()!=0:
        sys.exit('ktx-net must run as root')
    ap=argparse.ArgumentParser()
    sp=ap.add_subparsers(dest='cmd',required=True)
    c=sp.add_parser('create'); c.add_argument('instance')
    s=sp.add_parser('show'); s.add_argument('instance')
    r=sp.add_parser('remove'); r.add_argument('instance')
    sp.add_parser('list')
    a=ap.parse_args(); cfg=conf(); rows=load()
    pool=ipaddress.ip_network(cfg.get('KTX_DOCKER_POOL','172.28.0.0/16'))
    if pool.version!=4 or pool.prefixlen>28:
        sys.exit('KTX_DOCKER_POOL must be an IPv4 network no smaller than /28')
    prefix=cfg.get('KTX_NETWORK_PREFIX','ktx-net-')
    if a.cmd=='list':
        print('NAME\tSUBNET\tGATEWAY\tPRIMARY\tBRIDGE')
        for x in sorted(rows,key=lambda x:x['idx']):
            print(f"{x['name']}\t{x['subnet']}\t{x['gateway']}\t{x['primary']}\t{x['bridge']}")
        return
    row=get_row(rows,a.instance)
    if a.cmd=='show':
        if not row: sys.exit('not found')
        for k in ('name','subnet','gateway','primary','bridge'):
            print(f"{k}: {row[k]}")
        return
    if a.cmd=='create':
        if row: sys.exit(f"already exists: {row['name']}")
        name=prefix+a.instance if not a.instance.startswith(prefix) else a.instance
        used={x['idx'] for x in rows}
        subnets=list(pool.subnets(new_prefix=28))
        idx=next((i for i in range(len(subnets)) if i not in used),None)
        if idx is None: sys.exit('address pool exhausted')
        net=subnets[idx]; hosts=list(net.hosts()); gw=hosts[0]; primary=hosts[1]
        bridge=f"ktx{idx:04x}"[:15]
        run('docker','network','create','--driver','bridge','--subnet',str(net),'--gateway',str(gw),
            '--opt',f'com.docker.network.bridge.name={bridge}',name)
        row=dict(name=name,subnet=str(net),gateway=str(gw),primary=str(primary),bridge=bridge,idx=idx)
        rows.append(row); save(rows)
        for k in ('name','subnet','gateway','primary','bridge'):
            print(f"{k}: {row[k]}")
        return
    if a.cmd=='remove':
        if not row: sys.exit('not found')
        result=run('docker','network','rm',row['name'],check=False)
        if result.returncode!=0:
            sys.stderr.write(result.stderr); sys.exit(result.returncode)
        rows=[x for x in rows if x['name']!=row['name']]; save(rows)
        print(f"removed {row['name']}")

if __name__=='__main__': main()
