#!/usr/bin/env bash
set -euo pipefail
ROOT="${KTX_ROOT:-/srv/ktx}"

[[ "$(id -u)" -eq 0 ]] || { echo "ktx-install-native must run as root" >&2; exit 1; }
# shellcheck source=/dev/null
source "${ROOT}/host/versions.env"

arch_raw="$(uname -m)"
case "$arch_raw" in
  x86_64|amd64) arch=amd64; ssh_arch=x86_64 ;;
  aarch64|arm64) arch=arm64; ssh_arch=arm64 ;;
  *) echo "Unsupported architecture: ${arch_raw}" >&2; exit 1 ;;
esac

need() { command -v "$1" >/dev/null || { echo "Missing prerequisite: $1" >&2; exit 1; }; }
for c in curl tar sha256sum find install; do need "$c"; done

install_sshpiper() {
  local tmp asset base bin plugin
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  asset="sshpiperd_with_plugins_linux_${ssh_arch}.tar.gz"
  base="https://github.com/tg123/sshpiper/releases/download/v${SSHPIPER_VERSION}"
  echo "Installing SSHPiper ${SSHPIPER_VERSION}..."
  curl -fsSL "${base}/${asset}" -o "${tmp}/${asset}"
  curl -fsSL "${base}/checksums.txt" -o "${tmp}/checksums.txt"
  (cd "$tmp" && grep -F " ${asset}" checksums.txt | sha256sum -c -)
  mkdir "${tmp}/extract"; tar -xzf "${tmp}/${asset}" -C "${tmp}/extract"
  bin="$(find "${tmp}/extract" -type f -name sshpiperd -print -quit)"
  plugin="$(find "${tmp}/extract" -type f -name workingdir -print -quit)"
  [[ -n "$bin" && -n "$plugin" ]] || { echo "SSHPiper archive layout not recognized" >&2; exit 1; }
  install -d -m 0755 /usr/local/libexec/sshpiper
  install -o root -g root -m 0755 "$bin" /usr/local/libexec/sshpiper/sshpiperd
  install -o root -g root -m 0755 "$plugin" /usr/local/libexec/sshpiper/workingdir
  /usr/local/libexec/sshpiper/sshpiperd --version 2>/dev/null || true
}

install_traefik() {
  local tmp asset base
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  asset="traefik_v${TRAEFIK_VERSION}_linux_${arch}.tar.gz"
  base="https://github.com/traefik/traefik/releases/download/v${TRAEFIK_VERSION}"
  echo "Installing Traefik ${TRAEFIK_VERSION}..."
  curl -fsSL "${base}/${asset}" -o "${tmp}/${asset}"
  curl -fsSL "${base}/traefik_v${TRAEFIK_VERSION}_checksums.txt" -o "${tmp}/checksums.txt"
  (cd "$tmp" && grep -F " ${asset}" checksums.txt | sha256sum -c -)
  tar -xzf "${tmp}/${asset}" -C "$tmp"
  install -o root -g root -m 0755 "${tmp}/traefik" /usr/local/sbin/traefik
  /usr/local/sbin/traefik version
}

case "${1:-}" in
  sshpiper) install_sshpiper ;;
  traefik) install_traefik ;;
  all) install_sshpiper; install_traefik ;;
  *) echo "Usage: ktx-install-native {sshpiper|traefik|all}" >&2; exit 2 ;;
esac
