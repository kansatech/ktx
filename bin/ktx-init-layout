#!/usr/bin/env bash
set -euo pipefail
ROOT="${KTX_ROOT:-/srv/ktx}"

[[ "$(id -u)" -eq 0 ]] || { echo "ktx-init-layout must run as root" >&2; exit 1; }
[[ -f "${ROOT}/VERSION" && -d "${ROOT}/docs" ]] || { echo "${ROOT} is not a Kansatech/ktx checkout" >&2; exit 1; }

install -d -m 0755 "${ROOT}/config" "${ROOT}/containers" "${ROOT}/data" \
  "${ROOT}/releases" "${ROOT}/recovery" "${ROOT}/tmp" "${ROOT}/cache"
install -d -m 0700 "${ROOT}/secrets"
install -d -m 0750 "${ROOT}/logs"

# images/ contains independent module Git repositories and is human-managed.
if id ktx >/dev/null 2>&1; then
  install -d -o ktx -g ktx -m 0755 "${ROOT}/images"
else
  install -d -m 0755 "${ROOT}/images"
fi

install -d -m 0750 "${ROOT}/config/traefik/dynamic" "${ROOT}/data/traefik" \
  "${ROOT}/logs/traefik" "${ROOT}/logs/remote"
install -d -m 0700 "${ROOT}/config/sshpiper/routes" "${ROOT}/secrets/sshpiper"

if [[ ! -f "${ROOT}/config/host.conf" ]]; then
  install -m 0644 "${ROOT}/host/defaults/host.conf.example" "${ROOT}/config/host.conf"
fi

touch "${ROOT}/config/networks.tsv"
chmod 0644 "${ROOT}/config/networks.tsv"

echo "KTX local layout ready under ${ROOT}."
