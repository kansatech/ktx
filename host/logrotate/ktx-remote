/srv/ktx/logs/remote/*/*.log {
    su syslog adm
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

/srv/ktx/logs/traefik/*.log {
    su traefik traefik
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
